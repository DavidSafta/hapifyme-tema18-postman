		{
			"name": "Get Profile",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1) Status code 200\r",
							"pm.test(\"Status code is 200\", () => {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2) Email from profile = email generated at Register\r",
							"pm.test(\"Email matches generated email\", () => {\r",
							"  const json = pm.response.json();\r",
							"  const expectedEmail = pm.environment.get(\"email\");\r",
							"\r",
							"  pm.expect(expectedEmail, \"environment email should be set\").to.exist;\r",
							"  pm.expect(json.status, \"status should be success\").to.eql(\"success\");\r",
							"  pm.expect(json.user && json.user.email, \"user.email should exist\").to.eql(expectedEmail);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
